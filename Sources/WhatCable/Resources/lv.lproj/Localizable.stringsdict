<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld USB devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld USB ierīce</string>
			<key>other</key>
			<string>%lld USB ierīces</string>
			<key>zero</key>
			<string>0 USB ierīču</string>
		</dict>
	</dict>
	<key>%lld devices removed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ierīce noņemta</string>
			<key>other</key>
			<string>%lld ierīces noņemtas</string>
			<key>zero</key>
			<string>0 ierīču noņemtas</string>
		</dict>
	</dict>
	<key>Show %lld hubs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Rādīt %lld centrmezglu</string>
			<key>other</key>
			<string>Rādīt %lld centrmezglus</string>
			<key>zero</key>
			<string>Rādīt %lld centrmezglu</string>
		</dict>
	</dict>
</dict>
</plist>
